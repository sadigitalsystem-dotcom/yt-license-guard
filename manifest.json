{
  "manifest_version": 3,
  "name": "(يوتيوب بلس+) YouTube PLUS+",
  "version": "2.0.1",
  "description": "تجربة يوتيوب بريميوم رسمية 100% مع حجب الإعلانات والتشغيل بالخلفية ونظام الترخيص",
  "icons": {
    "128": "icon.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "https://plus.digitalsystemsa.com/*",
    "https://yt-license-guard.onrender.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "(يوتيوب بلس+) YouTube PLUS+"
  }
}
